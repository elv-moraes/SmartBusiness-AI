generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  MANAGER
  EMPLOYEE
}

enum StockMovementType {
  ENTRY
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  LOSS
  RETURN
}

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  document  String?  @unique
  email     String?
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users          User[]
  categories     Category[]
  products       Product[]
  stockMovements StockMovement[]

  @@map("companies")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([companyId, id])
  @@unique([companyId, name])
  @@index([companyId])
  @@map("categories")
}

model Product {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  categoryId    String   @map("category_id") @db.Uuid
  name          String   @db.VarChar(120)
  internalCode  String?  @map("internal_code") @db.VarChar(64)
  purchasePrice Decimal? @map("purchase_price") @db.Decimal(12, 2)
  salePrice     Decimal  @map("sale_price") @db.Decimal(12, 2)
  stockQuantity Int      @default(0) @map("stock_quantity")
  minimumStock  Int      @default(0) @map("minimum_stock")
  isActive      Boolean  @default(true) @map("is_active")
  version       Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  category       Category        @relation(fields: [companyId, categoryId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  stockMovements StockMovement[]

  @@unique([companyId, id])
  @@unique([companyId, internalCode])
  @@index([companyId, categoryId])
  @@index([companyId, name, id])
  @@map("products")
}

model StockMovement {
  id               String            @id @default(uuid()) @db.Uuid
  companyId        String            @map("company_id") @db.Uuid
  productId        String            @map("product_id") @db.Uuid
  type             StockMovementType
  quantity         Int
  previousQuantity Int               @map("previous_quantity")
  newQuantity      Int               @map("new_quantity")
  note             String?           @db.VarChar(500)
  idempotencyKey   String            @map("idempotency_key") @db.VarChar(128)
  createdByUserId  String            @map("created_by_user_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  product Product @relation(fields: [companyId, productId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([companyId, idempotencyKey])
  @@index([companyId, createdAt, id])
  @@index([companyId, productId, createdAt, id])
  @@map("stock_movements")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(EMPLOYEE)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@map("users")
}
